{
  "name": "cryptosimulator-root",
  "version": "1.0.0",
  "description": "Root package runner for MERN CryptoSimulator",
  "scripts": {
    "install-all": "npm install --prefix backend && npm install --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "cross-env NODE_ENV=production SERVE_FRONTEND=true node backend/server.js",
    "backend": "node backend/server.js",
    "frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\""
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3"
  }
}
